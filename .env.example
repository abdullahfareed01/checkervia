# Copy this file to .env and fill in the values. Never commit .env.
# These are read only by the Netlify function (netlify/functions/ai-move.ts).
# Do not add a VITE_ prefix: that would put the value in the browser bundle.
OPENROUTER_API_KEY=
LLM_MODEL=

# Leaderboard (D56). Read only by the leaderboard functions in netlify/functions.
# SUPABASE_URL: Project Settings, API, Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings, API Keys: a secret key (sb_secret_...)
#   or the legacy service_role key (a JWT starting with eyJ). Both work.
#   It bypasses Row Level Security: keep it in Netlify's environment only.
# LEADERBOARD_HASH_SALT: any long random text, made once and never changed
#   (changing it resets every rate limit window; stored hashes stop matching new ones).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEADERBOARD_HASH_SALT=

ADMIN_EMAIL=

SUPABASE_ANON_KEY=
